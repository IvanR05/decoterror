<script>
    const scrollArrow = document.querySelector('.scroll-arrow');
    
    if (scrollArrow) {
        scrollArrow.addEventListener('click', () => {
            const aboutSection = document.getElementById('about-me');
            if (aboutSection) {
                aboutSection.scrollIntoView({ 
                    behavior: 'smooth',
                    block: 'start'
                });
            } else {
                window.scrollBy({ 
                    top: window.innerHeight, 
                    behavior: 'smooth' 
                });
            }
        });
    }

    const halloweenMessage = document.getElementById('halloweenMessage');
    const today = new Date();
    const isHalloween = today.getDate() === 31 && today.getMonth() === 9;

    if (halloweenMessage && isHalloween) {
        halloweenMessage.classList.add('visible');
        document.body.classList.add('halloween-day');
    }
</script>

