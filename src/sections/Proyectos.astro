            image: "/projects/noria-de-tortura-con-tabla-de-pinchos-y-rueda-de-agua-antigua.jpg"
        },
    ];

    let currentYear = 2025;

    function renderProjects(year: number) {
        const projectsGrid = document.querySelector('.projects-grid');
        if (!projectsGrid) return;
        
        projectsGrid.innerHTML = '';
        
        const projectsArray = year === 2025 ? projects2025 : projects2024;
        
        projectsArray.forEach(project => {
            let div = document.createElement('div');
            div.className = 'project-card';
            div.innerHTML = `
                <img src="${project.image}" alt="${project.title}">
                <h3>${project.title}</h3>
            `;
            projectsGrid.appendChild(div);
        });
    }

    // Initial render
    renderProjects(currentYear);

    // Add event listeners to year buttons
        document.querySelectorAll('.year-btn').forEach(button => {
            const btn = button as HTMLButtonElement;
            btn.addEventListener('click', () => {
                const year = parseInt(btn.dataset.year || '2025');
                currentYear = year;
                
                // Update active state
                document.querySelectorAll('.year-btn').forEach(b => (b as HTMLButtonElement).classList.remove('active'));
                btn.classList.add('active');
                
                // Render projects for selected year
                renderProjects(year);
            });
        });
    
</script>

