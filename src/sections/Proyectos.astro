<article class="proyectos-section">
    <h2>Mis proyectos</h2>
    <div class="projects-grid">
        <div class="project-card">
            <div class="project-image-wrapper" style="position:relative; min-height:250px; border-radius:8px; overflow:hidden;">
                <img src="/projects/fondo-niña.jpg" alt="Fondo Niña" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                <img src="/projects/niña-pozo-nobg.png" alt="Niña del Pozo" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); max-width:70%; max-height:85%; object-fit:contain;">
            </div>
            <h3>Niña del Pozo</h3>
            <p>Un proyecto que combina elementos de terror y fantasía, creando una atmósfera inquietante y mágica al mismo tiempo.</p>
        </div>
        <div class="project-card">
            <img src="/projects/restricted-area.jpg" alt="Proyecto 2">
            <h3>Area Restringida con soldado y mascara</h3>
            <p>Creación de una zona de acceso restringido con temática de seguridad, incluyendo un soldado de cartón y efectos de sonido envolventes.</p>
        </div>
        <div class="project-card">
            <img src="/proyecto3.jpg" alt="Proyecto 3">
            <h3>Casa del Terror</h3>
            <p>Diseño y montaje de una casa del terror para eventos comunitarios, con diferentes habitaciones y sorpresas aterradoras.</p>
        </div>
    </div>

</article>

<script>
    const projects = [
        {
            title: "Niña del Pozo",
            description: "Un proyecto que combina elementos de terror y fantasía, creando una atmósfera inquietante y mágica al mismo tiempo.",
            image: "/projects/niña-pozo-nobg.png"
        },
        {
            title: "Area Restringida con soldado y mascara",
            description: "Creación de una zona de acceso restringido con temática de seguridad, incluyendo un soldado de cartón y efectos de sonido envolventes.",
            image: "/projects/restricted-area.jpg"
        },
        {
            title: "Casa del Terror",
            description: "Diseño y montaje de una casa del terror para eventos comunitarios, con diferentes habitaciones y sorpresas aterradoras.",
            image: "/proyecto3.jpg"
        }
    ];

    projects.forEach(project => {
        let div = document.createElement('div');
        div.className = 'project-card';
        div.innerHTML = `
            <img src="${project.image}" alt="${project.title}">
            <h3>${project.title}</h3>
            <p>${project.description}</p>
        `;
        document.querySelector('.projects-grid')?.appendChild(div);
    });
    
</script>

