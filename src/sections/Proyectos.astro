---
import projects2024 from '../data/projects/2024.json';
import projects2025 from '../data/projects/2025.json';
import projects2023 from '../data/projects/2023.json';
---

<article class="proyectos-section" id="proyectos">
    <div class="divider">
        <span></span>
        <span>Mis proyectos</span>
        <span></span>
    </div>
    <div class="year-buttons">
        <button class="year-btn active" data-year="2025">2025</button>
        <button class="year-btn" data-year="2024">2024</button>
        <button class="year-btn" data-year="2023">2023</button>
    </div>
    <div class="projects-grid">
        <!-- Project cards will be injected here by JavaScript -->
    </div>

</article>

<script define:vars={{ projects2023, projects2024, projects2025 }}>
    let currentYear = 2025;

    function renderProjects(year) {
        const projectsGrid = document.querySelector('.projects-grid');
        if (!projectsGrid) return;

        projectsGrid.innerHTML = '';

        const projectsMap = {
            2025: projects2025,
            2024: projects2024,
            2023: projects2023
        };


        projectsMap[year]?.forEach(project => {
            let div = document.createElement('a');
            div.className = 'project-card';
            div.setAttribute("href", `/proyectos/${project.slug}`)
            div.innerHTML = `
                <a href="/proyectos/${project.slug}" class="project-link">
                    <img src="${project.thumbnail}" alt="${project.title}" loading="lazy">
                </a>
                <h3>${project.title}</h3>
            `;
            projectsGrid.appendChild(div);
        });
    }

    // Initial render
    renderProjects(currentYear);

    // Add event listeners to year buttons
    document.querySelectorAll('.year-btn').forEach(button => {
        button.addEventListener('click', () => {
            const year = parseInt(button.dataset.year || '2025');
            currentYear = year;
            
            // Update active state
            document.querySelectorAll('.year-btn').forEach(b => b.classList.remove('active'));
            button.classList.add('active');
            
            // Render projects for selected year
            renderProjects(year);
        });
    });
    
</script>

<style>
    .proyectos-section {
        padding: 2rem;
        color: #ffffff;
    }

    .divider {
        display: table;
        font-size: 2.5rem;
        text-align: center;
        width: 75%;
        margin: 0 auto 2rem auto;
        color: #ffffff;
    }

    .divider span {
        display: table-cell;
        position: relative;
    }

    .divider span:first-child,
    .divider span:last-child {
        width: 50%;
        background-size: 100% 3px;
        background-position: 0 50%;
        background-repeat: no-repeat;
    }

    .divider span:first-child {
        background-image: linear-gradient(90deg, transparent, #a32606);
    }

    .divider span:nth-child(2) {
        color: #ffffff;
        padding: 0px 20px;
        width: auto;
        white-space: nowrap;
        font-weight: bold;
    }

    .divider span:last-child {
        background-image: linear-gradient(90deg, #a32606, transparent);
    }

    .year-buttons {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .year-btn {
        padding: 0.75rem 2rem;
        font-size: 1.2rem;
        font-weight: bold;
        background-color: rgb(27, 27, 27);
        color: #ffffff;
        border: 2px solid #f13000;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .year-btn:hover {
        background-color: #f13000;
        transform: translateY(-3px);
    }

    .year-btn.active {
        background-color: #f13000;
        box-shadow: 0 0 20px rgba(241, 48, 0, 0.5);
    }

    .proyectos-section :global(.projects-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2.5rem;
    }

    .proyectos-section :global(.project-card) {
        background-color: rgb(27, 27, 27);
        border-radius: 8px;
        border: 2px solid rgb(147, 40, 40);
        padding: 1rem;
        text-align: center;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.815));
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform: translateY(0) rotate(0deg);
        /*cursor: pointer;*/
        min-height: 350px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    .proyectos-section :global(.project-link) {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        /*height: 100%;*/
        transition: all 0.3s ease;
    }

    .proyectos-section :global(.project-link:hover) {
        transform: translateY(-5px);
    }

    .proyectos-section :global(.project-card img) {
        width: 100%;
        height: auto;
        max-height: 250px;
        object-fit: contain;
        border-radius: 8px;
        margin-bottom: 1rem;
        transition: transform 0.4s ease;
    }

    .proyectos-section :global(.project-card:hover) {
        transform: translateY(-12px) rotate(-1deg);
        border: 2px solid red;
        border-color: red;
    }

    .proyectos-section :global(.project-card:hover img) {
        transform: scale(1.05);
    }

    .proyectos-section :global(.project-card:hover h3) {
        color: #ff3d0d;
    }

    .proyectos-section :global(.project-card h3) {
        margin: 1rem 0px;
        color: #f13000;
        min-height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Responsive design for mobile */
    @media (max-width: 768px) {
        .proyectos-section {
            padding: 1.5rem 1rem;
        }

        .divider {
            font-size: 2rem;
            margin-bottom: 1.5rem;
            width: 85%;
        }

        .divider span:nth-child(2) {
            padding: 0px 15px;
        }

        .year-buttons {
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .year-btn {
            padding: 0.6rem 1.5rem;
            font-size: 1rem;
        }

        .proyectos-section :global(.projects-grid) {
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .proyectos-section :global(.project-card) {
            padding: 0.875rem;
            min-height: 300px;
        }

        .proyectos-section :global(.project-card img) {
            max-height: 200px;
        }

        .proyectos-section :global(.project-card h3) {
            font-size: 1rem;
            margin: 0.75rem 0px;
        }

        .proyectos-section :global(.project-card p) {
            font-size: 0.9rem;
        }
    }

    @media (max-width: 480px) {
        .proyectos-section {
            padding: 1rem 0.75rem;
        }

        .divider {
            font-size: 1.75rem;
            margin-bottom: 1rem;
            width: 90%;
        }

        .divider span:nth-child(2) {
            padding: 0px 10px;
        }

        .year-buttons {
            gap: 0.5rem;
            margin-bottom: 1rem;
            padding: 0 1rem;
        }

        .year-btn {
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
        }

        .proyectos-section :global(.projects-grid) {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .proyectos-section :global(.project-card) {
            padding: 0.75rem;
            min-height: 280px;
        }

        .proyectos-section :global(.project-card img) {
            max-height: 180px;
        }

        .proyectos-section :global(.project-card h3) {
            font-size: 0.95rem;
            margin: 0.5rem 0px;
        }

        .proyectos-section :global(.project-card:hover) {
            transform: translateY(-8px) rotate(-1deg);
        }
    }
</style>