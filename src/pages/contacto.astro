---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main>
        <section class="contact-section">
            <div class="contact-container animate-fade-in-up">
                <h1>Contáctame</h1>
                <p class="subtitle">¿Tienes alguna pregunta o quieres solicitar presupuesto?</p>
                
                <div class="contact-info">
                    <a href="mailto:emiruco74@gmail.com" class="contact-item">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="#ff8c00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <polyline points="22,6 12,13 2,6" stroke="#ff8c00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div>
                            <h2>Correo electrónico</h2>
                            <span class="email-link">
                                emiruco74@gmail.com
                            </span>
                        </div>
                    </a>

                    <a href="https://www.instagram.com/decoterror/" target="_blank" class="contact-item">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" fill="#E1306C"/>
                        </svg>
                        <div>
                            <h2>Instagram</h2>
                            <span class="instagram-link">
                                @decoterror
                            </span>
                        </div>
                    </a>
                </div>

                <a href="/" class="back-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Volver al inicio
                </a>
            </div>
        </section>
    </main>
</Layout>

<style>
    main {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: url('/fondoaside.webp') center/cover no-repeat;
        position: relative;
    }

    main::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(3px);
    }

    .contact-section {
        width: 100%;
        padding: 2rem;
        position: relative;
        z-index: 1;
    }

    .contact-container {
        max-width: 800px;
        margin: 0 auto;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(10px);
        padding: 3rem 2rem;
        border-radius: 20px;
        border: 2px solid rgba(255, 140, 0, 0.3);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    h1 {
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        color: rgb(205 37 16);
        text-shadow:
            0 0 20px rgba(205, 37, 16, 0.6),
            4px 4px 8px rgba(101, 0, 0, 0.9),
            8px 10px 10px rgba(0, 0, 0, 0.8);
        font-family: "Nosifer", "Metal Mania", system-ui;
        margin: 0 0 1rem 0;
        text-align: center;
    }

    .subtitle {
        font-size: clamp(1rem, 3vw, 1.3rem);
        color: white;
        text-align: center;
        font-family: "Metal Mania", system-ui;
        margin: 0 0 3rem 0;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        background: rgba(255, 140, 0, 0.1);
        padding: 2rem;
        border-radius: 15px;
        border: 2px solid rgba(255, 140, 0, 0.3);
        transition: all 0.3s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .contact-item:hover {
        background: rgba(255, 140, 0, 0.15);
        border-color: rgba(255, 140, 0, 0.5);
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(255, 140, 0, 0.2);
    }

    .contact-item svg {
        flex-shrink: 0;
    }

    .contact-item h2 {
        font-size: 1.3rem;
        color: #ff8c00;
        margin: 0 0 0.5rem 0;
        font-family: "Metal Mania", system-ui;
    }

    .email-link,
    .instagram-link {
        font-size: 1.2rem;
        color: white;
        font-weight: 600;
        font-family: system-ui, -apple-system, sans-serif;
        display: block;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 140, 0, 0.9);
        color: white;
        padding: 1rem 2rem;
        border-radius: 50px;
        text-decoration: none;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(255, 140, 0, 0.3);
        transition: all 0.3s ease;
        margin: 0 auto;
        display: flex;
        width: fit-content;
    }

    .back-btn:hover {
        background: rgba(255, 140, 0, 1);
        box-shadow: 0 6px 20px rgba(255, 140, 0, 0.5);
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .contact-section {
            padding: 1rem;
        }

        .contact-container {
            padding: 2rem 1rem;
        }

        h1 {
            font-size: clamp(1.8rem, 8vw, 2.5rem);
            word-wrap: break-word;
        }

        .subtitle {
            font-size: clamp(0.9rem, 4vw, 1.1rem);
            padding: 0 0.5rem;
        }

        .contact-item {
            flex-direction: column;
            text-align: center;
            padding: 1.5rem 1rem;
        }

        .contact-item h2 {
            font-size: 1.1rem;
        }

        .email-link,
        .instagram-link {
            font-size: 0.9rem;
            word-wrap: break-word;
            overflow-wrap: break-word;
            max-width: 100%;
            display: inline-block;
        }

        .back-btn {
            font-size: 0.95rem;
            padding: 0.875rem 1.5rem;
        }
    }
</style>
