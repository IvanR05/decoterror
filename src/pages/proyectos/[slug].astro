---
import ProjectPage from '../../layouts/ProjectPage.astro';
import projects2023 from '../../data/projects/2023.json';
import projects2024 from '../../data/projects/2024.json';
import projects2025 from '../../data/projects/2025.json';

export async function getStaticPaths() {
  const allProjects = [
    ...projects2023,
    ...projects2024,
    ...projects2025
  ];

  return allProjects.map(project => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<ProjectPage>
  <article class="project-detail">
    <nav class="project-navigation">
      <a href="/#proyectos" class="back-button">
        <span class="back-arrow">←</span>
        <span>Volver a proyectos</span>
      </a>
    </nav>

    <div class="project-content">
      <!-- Gallery Section (Left) -->
      <div class="gallery-section">
        <div class="main-image-container">
          <button class="nav-arrow prev-arrow" id="prevBtn" aria-label="Imagen anterior">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
            </svg>
          </button>
          <img
            id="mainImage"
            src={project.images[0]}
            alt={`${project.title} - Imagen 1`}
            class="main-image"
          />
          <video
            id="mainVideo"
            class="main-image"
            controls
            style="display: none;"
          >
            <source id="videoSource" src="" type="video/mp4" />
            Tu navegador no soporta el elemento de video.
          </video>
          <button class="nav-arrow next-arrow" id="nextBtn" aria-label="Imagen siguiente">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
          </button>
        </div>

        <!-- Thumbnail strip -->
        <div class="thumbnail-strip" id="thumbnailStrip">
          {project.images.map((image, index) => {
            const isVideo = image.endsWith('.mp4') || image.endsWith('.webm') || image.endsWith('.ogg');
            return (
              <div class={`thumbnail-wrapper ${index === 0 ? 'active' : ''}`} data-index={index}>
                {isVideo ? (
                  <div class="video-thumbnail">
                    <div class="video-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                    <span class="video-label">VIDEO</span>
                  </div>
                ) : (
                  <img
                    src={image}
                    alt={`${project.title} - Miniatura ${index + 1}`}
                    class="thumbnail"
                    loading="lazy"
                  />
                )}
              </div>
            );
          })}
        </div>

        <!-- Image counter -->
        <div class="image-counter">
          <span id="currentImage">1</span> / <span id="totalImages">{project.images.length}</span>
        </div>
      </div>

      <!-- Info Section (Right) -->
      <div class="info-section">
        <header class="project-header">
          <div class="year-badge">🎃 {project.year}</div>
          <h1>{project.title}</h1>
          {project.description && (
            <>
              <div class="separator">
                <span></span>
                <span class="pumpkin">🎃</span>
                <span></span>
              </div>
              <p class="project-description">{project.description}</p>
            </>
          )}
        </header>

        <div class="action-box">
          <p class="action-text">¿Te gusta este proyecto?</p>
          <a href="/contacto" class="contact-project-btn">
            <span>Contáctame</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </article>
</ProjectPage>

<script define:vars={{ project }}>
  class ImageGallery {
    constructor() {
      this.currentIndex = 0;
      this.images = project.images;
      this.mainImage = document.getElementById('mainImage');
      this.mainVideo = document.getElementById('mainVideo');
      this.videoSource = document.getElementById('videoSource');
      this.thumbnails = document.querySelectorAll('.thumbnail-wrapper');
      this.currentCounter = document.getElementById('currentImage');
      this.totalCounter = document.getElementById('totalImages');
      this.prevBtn = document.getElementById('prevBtn');
      this.nextBtn = document.getElementById('nextBtn');

      this.init();
    }

    init() {
      this.prevBtn.addEventListener('click', () => this.prevImage());
      this.nextBtn.addEventListener('click', () => this.nextImage());

      this.thumbnails.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const index = parseInt(thumb.getAttribute('data-index'));
          this.goToImage(index);
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') this.prevImage();
        if (e.key === 'ArrowRight') this.nextImage();
      });

      this.updateDisplay();
    }

    goToImage(index) {
      this.currentIndex = index;
      this.updateDisplay();
    }

    prevImage() {
      this.currentIndex = this.currentIndex > 0 ? this.currentIndex - 1 : this.images.length - 1;
      this.updateDisplay();
    }

    nextImage() {
      this.currentIndex = this.currentIndex < this.images.length - 1 ? this.currentIndex + 1 : 0;
      this.updateDisplay();
    }

    updateDisplay() {
      const currentMedia = this.images[this.currentIndex];
      const isVideo = currentMedia.endsWith('.mp4') || currentMedia.endsWith('.webm') || currentMedia.endsWith('.ogg');

      if (isVideo) {
        this.mainImage.style.display = 'none';
        this.mainVideo.style.display = 'block';
        this.videoSource.src = currentMedia;
        this.mainVideo.load();
      } else {
        this.mainVideo.style.display = 'none';
        this.mainImage.style.display = 'block';
        this.mainImage.src = currentMedia;
        this.mainImage.alt = `${project.title} - Imagen ${this.currentIndex + 1}`;
      }

      this.thumbnails.forEach((thumb) => {
        const index = parseInt(thumb.getAttribute('data-index'));
        thumb.classList.toggle('active', index === this.currentIndex);
      });

      this.currentCounter.textContent = this.currentIndex + 1;

      const activeThumb = document.querySelector('.thumbnail-wrapper.active');
      if (activeThumb) {
        activeThumb.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center'
        });
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new ImageGallery();
  });
</script>

<style>
  .project-detail {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    color: #ffffff;
  }

  .project-navigation {
    margin-bottom: 2rem;
    text-align: left;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #1a0a0a 0%, #2d0f0f 100%);
    color: #ff8c00;
    text-decoration: none;
    border: 2px solid #f13000;
    border-radius: 50px;
    font-weight: bold;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(241, 48, 0, 0.2);
  }

  .back-arrow {
    transition: transform 0.3s ease;
  }

  .back-button:hover {
    background: linear-gradient(135deg, #2d0f0f 0%, #3d1515 100%);
    color: #ffad33;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(241, 48, 0, 0.4);
  }

  .back-button:hover .back-arrow {
    transform: translateX(-4px);
  }

  .project-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: start;
  }

  /* Gallery Section */
  .gallery-section {
    position: sticky;
    top: 2rem;
  }

  .main-image-container {
    position: relative;
    margin-bottom: 1.5rem;
    border-radius: 16px;
    overflow: hidden;
    border: 3px solid #f13000;
    background: linear-gradient(135deg, #0d0d0d 0%, #1a0a0a 100%);
    box-shadow:
      0 0 0 1px rgba(241, 48, 0, 0.3),
      0 10px 40px rgba(0, 0, 0, 0.8),
      0 0 30px rgba(241, 48, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-image {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
    display: block;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.75);
    color: #ff8c00;
    border: 2px solid #f13000;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    display: grid;
    place-items: center;
    z-index: 10;
    margin: 0 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
  }

  .nav-arrow svg {
    width: 28px;
    height: 28px;
  }

  .nav-arrow:hover {
    background: rgba(241, 48, 0, 0.9);
    color: white;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 0 20px rgba(241, 48, 0, 0.6);
  }

  .prev-arrow {
    left: 12px;
  }

  .next-arrow {
    right: 12px;
  }

  .thumbnail-strip {
    display: flex;
    gap: 0.85rem;
    overflow-x: auto;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    border: 1px solid rgba(241, 48, 0, 0.2);
    scrollbar-width: thin;
    scrollbar-color: #f13000 rgba(27, 27, 27, 0.5);
  }

  .thumbnail-strip::-webkit-scrollbar {
    height: 6px;
  }

  .thumbnail-strip::-webkit-scrollbar-track {
    background: rgba(27, 27, 27, 0.5);
    border-radius: 3px;
  }

  .thumbnail-strip::-webkit-scrollbar-thumb {
    background: #f13000;
    border-radius: 3px;
  }

  .thumbnail-wrapper {
    width: 85px;
    height: 85px;
    border-radius: 10px;
    border: 2px solid rgba(241, 48, 0, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
    background: #1a0a0a;
  }

  .thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a0a0a 0%, #2d0f0f 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .video-icon {
    width: 28px;
    height: 28px;
    color: #f13000;
  }

  .video-icon svg {
    width: 100%;
    height: 100%;
  }

  .video-label {
    font-size: 0.6rem;
    font-weight: bold;
    color: #ff8c00;
    letter-spacing: 1px;
  }

  .thumbnail-wrapper:hover {
    transform: scale(1.08);
    border-color: #ff8c00;
    box-shadow: 0 0 15px rgba(241, 48, 0, 0.3);
  }

  .thumbnail-wrapper:hover .thumbnail {
    transform: scale(1.1);
  }

  .thumbnail-wrapper.active {
    border-color: #ff8c00;
    box-shadow: 0 0 20px rgba(241, 48, 0, 0.5);
    transform: scale(1.05);
  }

  .image-counter {
    text-align: center;
    font-size: 1.1rem;
    color: #ff8c00;
    font-weight: bold;
    margin-top: 1rem;
    font-family: 'Metal Mania', cursive;
    letter-spacing: 1px;
  }

  /* Info Section */
  .info-section {
    padding-top: 1rem;
  }

  .project-header {
    background: linear-gradient(135deg, rgba(26, 10, 10, 0.95) 0%, rgba(45, 15, 15, 0.9) 100%);
    border: 2px solid #f13000;
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.6),
      0 0 30px rgba(241, 48, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .project-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #f13000, #ff8c00, #f13000);
  }

  .year-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(241, 48, 0, 0.15);
    color: #ff8c00;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: bold;
    margin-bottom: 1rem;
    border: 1px solid rgba(241, 48, 0, 0.3);
  }

  .project-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #f13000;
    margin: 0 0 1rem;
    font-family: 'Metal Mania', cursive;
    line-height: 1.1;
    text-shadow:
      0 0 20px rgba(241, 48, 0, 0.4),
      2px 2px 4px rgba(0, 0, 0, 0.8);
  }

  .separator {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0 1.5rem;
  }

  .separator span:first-child,
  .separator span:last-child {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, transparent, #f13000, transparent);
  }

  .pumpkin {
    font-size: 1.4rem;
    filter: drop-shadow(0 0 8px rgba(255, 140, 0, 0.6));
  }

  .project-description {
    font-size: 1.15rem;
    color: #e8e8e8;
    line-height: 1.7;
    margin: 0;
  }

  .action-box {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(241, 48, 0, 0.25);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
  }

  .action-text {
    color: #ff8c00;
    font-family: 'Metal Mania', cursive;
    font-size: 1.3rem;
    margin: 0 0 1rem;
    letter-spacing: 0.5px;
  }

  .contact-project-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    background: linear-gradient(135deg, #f13000 0%, #cd2507 100%);
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: bold;
    font-size: 1.05rem;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(241, 48, 0, 0.4);
    border: 2px solid transparent;
  }

  .contact-project-btn:hover {
    background: linear-gradient(135deg, #ff4500 0%, #f13000 100%);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(241, 48, 0, 0.6);
    border-color: #ff8c00;
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .project-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .gallery-section {
      position: static;
      order: 2;
    }

    .info-section {
      order: 1;
      padding-top: 0;
    }

    .main-image {
      max-height: 450px;
    }
  }

  @media (max-width: 768px) {
    .project-detail {
      padding: 1rem;
    }

    .project-header {
      padding: 1.5rem;
    }

    .project-description {
      font-size: 1rem;
    }

    .main-image {
      max-height: 350px;
    }

    .thumbnail-wrapper {
      width: 70px;
      height: 70px;
    }

    .video-icon {
      width: 24px;
      height: 24px;
    }

    .video-label {
      font-size: 0.5rem;
    }

    .nav-arrow {
      width: 40px;
      height: 40px;
      margin: 0 0.5rem;
    }

    .nav-arrow svg {
      width: 22px;
      height: 22px;
    }

    .prev-arrow {
      left: 8px;
    }

    .next-arrow {
      right: 8px;
    }
  }

  @media (max-width: 480px) {
    .thumbnail-strip {
      gap: 0.6rem;
      padding: 0.75rem;
    }

    .thumbnail-wrapper {
      width: 60px;
      height: 60px;
    }

    .video-icon {
      width: 20px;
      height: 20px;
    }

    .video-label {
      font-size: 0.45rem;
    }

    .action-text {
      font-size: 1.1rem;
    }

    .contact-project-btn {
      padding: 0.75rem 1.5rem;
      font-size: 0.95rem;
    }
  }
</style>
